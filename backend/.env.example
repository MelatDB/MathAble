# MathAble backend - environment template.
#
# Copy this file to `.env` and fill in your own values:
#   cp .env.example .env
#
# Never commit a real `.env` (it is git-ignored).  Every value here has a safe
# default in backend/app/config.py, so the server also runs without a `.env`.

# SQLAlchemy database URL.  Default is a SQLite file alongside the backend.
DATABASE_URL=sqlite:///./mathable.db

# Secret used to sign JWT tokens.  Use a long random string in production.
SECRET_KEY=change-me-to-a-long-random-string

# JWT signing algorithm.
JWT_ALGORITHM=HS256

# Access token lifetime in minutes (default 1 day).
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Comma-separated list of allowed frontend origins (CORS).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Secret key required to register a teacher account.
# Leave empty (or omit) to disable teacher self-registration entirely.
# Anyone who knows this key can register a teacher account, so treat it
# like a password and share it only with your teaching staff.
# Example: TEACHER_REGISTRATION_KEY=my-school-teacher-secret-2024
TEACHER_REGISTRATION_KEY=
